# ===================================================================
# Frontend Environment Configuration Template (Vite)
# Copy this file to .env and adjust values as needed
# ===================================================================

# Base API URL pointing to Spring Boot Backend
VITE_API_BASE_URL=http://localhost:8080/api

# Real-time WebSocket URL
VITE_WEBSOCKET_URL=ws://localhost:8080/api/ws

# Application Metadata
VITE_APP_TITLE=Digital Pass Library & Bookstore

# Data Fallback Flag (true to use mock initial data when API is unreachable)
VITE_ENABLE_MOCK_DATA=true
