# ===================================================================
# Backend Environment Configuration Template
# Copy this file to .env and adjust values as needed
# ===================================================================

# Server Settings
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Application Settings
SPRING_APPLICATION_NAME=digital-library-backend

# Database Configuration (H2 / PostgreSQL / MySQL)
SPRING_DATASOURCE_URL=jdbc:h2:mem:librarydb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# H2 Console Configuration
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console
SPRING_H2_CONSOLE_SETTINGS_WEB_ALLOW_OTHERS=true

# JPA & Hibernate Settings
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# JWT Security Configuration
JWT_SECRET=your_base64_or_hex_encoded_secret_key_here_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# Digital Library Business Parameters
LIBRARY_FINE_PER_DAY=10.0
LIBRARY_MAX_BOOKS_PER_STUDENT=5
LIBRARY_MAX_LOAN_DAYS=14
LIBRARY_MAX_RENEWALS=2
LIBRARY_RESERVATION_EXPIRY_HOURS=48
LIBRARY_STORE_TAX_PERCENT=5.0
LIBRARY_STORE_SHIPPING_FEE=40.0

# Logging Levels
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
